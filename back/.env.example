TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
# --- Inteligência Artificial Externa: Google Gemini (provedor único) ---
# Chave da API do Google Gemini. Obtenha a sua gratuita em:
# https://aistudio.google.com
# O prefixo GEMINI_API_KEY tem precedência; AI_EXTERNAL_API_KEY é o legado.
GEMINI_API_KEY=
AI_EXTERNAL_API_KEY=
# Modelo Gemini em uso. Opções testadas: gemini-3.5-flash (padrão),
# gemini-3.7-flash, gemini-3.8-flash e gemini-3.1-pro-preview. O prefixo
# "models/" é removido automaticamente (evita o erro HTTP 404 da API oficial)
# e modelos descontinuados pelo Google viram fallback automático.
AI_EXTERNAL_MODEL=gemini-3.5-flash
PORT=8000
YOLO_MODEL=yolov8n.pt
# Sensibilidade da detecção: menor valor = detecta aves mais distantes, pequenas,
# camufladas ou paradas ao pousar. Faixa aceita: 0.05 a 1.0.
# Padrão de ALTA SENSIBILIDADE do Bem-Te-Vi Core: 0.22.
YOLO_CONFIDENCE=0.22
# Tempo máximo (s) que o rastreio mantém a visita mesmo com a ave imóvel
# se alimentando (o YOLO costuma perdê-la). Faixa: 0 a 30 (recomendado: 8 a 15).
OBJECT_PERSISTENCE_TIME=10.0
# Sensibilidade de detecção de movimento inicial (0 a 1).
# Maior = detecta movimentos mais sutis (aves chegando ao comedouro).
MOTION_SENSITIVITY=0.80
# Classe do COCO para "bird" (14 é o padrão).
YOLO_BIRD_CLASS_ID=14
# --- Edge AI: aceleração da inferência (alta performance) ---
# Backend preferido: auto (TensorRT > ONNX > PyTorch), engine/tensorrt, onnx ou pt.
# Em "auto", usa o artefato otimizado (.engine/.onnx) se existir ao lado do .pt.
# Gere-o com: python -m tools.exportar_modelo --formato onnx
YOLO_ACCELERATION=auto
# Dispositivo: auto (GPU se houver, senão CPU), cpu ou 0/1... (índice da GPU).
YOLO_DEVICE=auto
# FP16 no PyTorch em GPU CUDA (quase 2x mais rápido; ignorado em CPU/TRT/ONNX).
YOLO_HALF=false
# Tamanho de entrada da inferência (px). 640 é o padrão; 960/1280 aumentam o
# recall de aves pequenas ao custo de mais tempo.
YOLO_IMGSZ=640
# Test-Time Augmentation global (reforço de recall; mais lento).
YOLO_TTA=false
# Contraste adaptativo (CLAHE) antes da inferência: revela aves pequenas e
# camufladas contra o fundo do comedouro (não afeta a imagem gravada). LIGADO
# por padrão para reforçar a sensibilidade.
ROI_ADAPTIVE_CONTRAST=true
# --- Supressão de spam: "mesma ave = mesmo evento" ---
# Tempo (s) de ausência necessário para ENCERRAR a presença de uma ave na zona.
# Enquanto a ave permanecer (mesmo que o YOLO a perca por instantes), NÃO há novo
# alerta/registro. Só após esse tempo uma nova ave pode disparar um novo evento.
# Ajuste para 30 ou 60 s conforme o comedouro. Faixa: 0 a 600.
PRESENCE_GRACE_SECONDS=30
# Cooldown mínimo (s) entre alertas na MESMA zona (piso de segurança extra, além
# do cooldown por zona configurado no painel). Faixa: 0 a 600.
ALERT_COOLDOWN_SECONDS=30
PRE_RECORD_SECONDS=3.0
# Segundos gravados DEPOIS do gatilho. Com o pré-roll de 3.0 s, o clipe final
# cobre ~6 s (3 s antes + instante do evento + 3 s depois).
POST_RECORD_SECONDS=3.0
CAMERA_RECONNECT_DELAY_SEC=3.0
MEDIA_RETENTION_DAYS=30
# Localização do alimentador (usada pela integração meteorológica Open-Meteo).
# Latitude/longitude em graus decimais. Padrão: São Paulo/SP.
LATITUDE=-23.5505
LONGITUDE=-46.6333
# Intervalo (minutos) de atualização do cache local de clima (padrão: 30).
WEATHER_CACHE_MINUTES=30
# Curadoria automática de Momentos Raros (fotos mais nítidas / espécies raras).
# Liga/desliga o agendador (true/false).
RARE_MOMENTS_ENABLED=true
# Intervalo (horas) entre varreduras automáticas de nitidez (1 a 48).
RARE_MOMENTS_SCAN_HOURS=6
# Janela padrão (dias) da curadoria exibida na galeria (1 a 90).
RARE_MOMENTS_DAYS=7
# Visão noturna (infravermelho / baixa luz). Modo: auto, on ou off
# (também aceita true/false: true = on, false = off).
NIGHT_VISION_MODE=auto
# Luminância média (0-255) abaixo da qual o modo "auto" considera baixa luz.
NIGHT_VISION_THRESHOLD=60
# Intensidade do realce de contraste local (CLAHE): 1.0 a 8.0.
NIGHT_VISION_CLAHE_CLIP=2.5
# Tamanho da grade do CLAHE (blocos por lado): 2 a 16.
NIGHT_VISION_CLAHE_GRID=8
# Redução de ruído leve antes do realce (true/false).
NIGHT_VISION_DENOISE=true
# Fauna noturna: expande as classes detectadas além de aves (true/false).
NIGHT_FAUNA_ENABLED=false
# Classes extras do COCO quando a fauna noturna está ligada (15=gato, 16=cachorro).
NIGHT_FAUNA_CLASS_IDS=15,16
# --- Análise offline de vídeos (cartão de memória) ---
# Limiar de confiança dedicado à análise offline (mais sensível que o ao vivo).
OFFLINE_YOLO_CONFIDENCE=0.25
# Passo de amostragem de quadros (1 = todos; 2 = um a cada dois). Maior = mais rápido.
OFFLINE_FRAME_STRIDE=2
# Número máximo de trechos curtos gerados por vídeo (um por ave distinta).
OFFLINE_MAX_CLIPS=12
# Duração (s) do trecho salvo ao redor da melhor captura de cada ave.
OFFLINE_CLIP_SECONDS=4.0
# --- Gravação inteligente: melhor quadro + melhoria da imagem ---
# Escolhe automaticamente o quadro mais nítido da janela de gravação (true/false).
BEST_FRAME_ENABLED=true
# Proporção ideal da tela (0-1) que a ave deve ocupar no melhor quadro.
BEST_FRAME_IDEAL_AREA_RATIO=0.08
# Escala de normalização da nitidez (variância do Laplaciano). Padrão: 120.
BEST_FRAME_SHARPNESS_SCALE=120
# Nitidez mínima (variância do Laplaciano) para aceitar o quadro. Abaixo disto o
# quadro é descartado como desfoque de movimento. Padrão: 20.
BEST_FRAME_MIN_SHARPNESS=20
# Melhoria automática (CLAHE + redução de ruído) da foto oficial (true/false).
ENHANCEMENT_ENABLED=true
# Intensidade do CLAHE (1.0 a 8.0) e grade de blocos (2 a 16).
ENHANCEMENT_CLAHE_CLIP=2.0
ENHANCEMENT_CLAHE_GRID=8
# Redução de ruído (true/false) e força (0 a 20) do denoise não-linear.
ENHANCEMENT_DENOISE=true
ENHANCEMENT_DENOISE_STRENGTH=5.0
# Faixa de largura (px) da foto tratada: limita o custo acima do máximo e
# garante "alta definição" abaixo do mínimo.
ENHANCEMENT_MAX_WIDTH=1280
ENHANCEMENT_MIN_WIDTH=720
# Qualidade JPEG da foto tratada (50 a 100).
ENHANCEMENT_JPEG_QUALITY=95
# Overlays visuais do Bem-Te-Vi Core nos clipes gravados: grava a tarja de
# identificação (marca Bem-Te-Vi Core + espécie + confiança + câmera/horário) no vídeo
# salvo, para que a espécie seja identificável mesmo fora do painel.
# Não afeta o stream ao vivo (que desenha as caixas em tempo real).
CLIP_OVERLAY_ENABLED=true
# Crop inteligente do recorte da ave: margem de contexto ao redor da caixa
# (fração do tamanho dela) e faixa de dimensão (px) do recorte final.
SMART_CROP_MARGIN=0.25
SMART_CROP_MIN_DIMENSION=640
SMART_CROP_MAX_DIMENSION=1024
# --- IA ciente do contexto (clima/horário) ---
# Ajusta automaticamente a sensibilidade conforme o clima (chuva/nublado) e a
# baixa luz, sempre de forma conservadora (só torna mais permissivo).
ADAPTIVE_CONTEXT_ENABLED=true
# --- Análise de comportamento ---
# Quando ligado, só registra a visita se a ave estiver efetivamente se
# alimentando (bico no comedouro/bebedouro). Desligado por padrão.
BEHAVIOR_REQUIRE_FEEDING=false
# --- Log de anomalias acústico-visuais (uso científico) ---
# Registra uma anomalia quando uma espécie reaparece após um longo intervalo.
ANOMALY_LOG_ENABLED=true
# Intervalo (dias) sem registro a partir do qual o retorno é anomalia (~6 meses).
ANOMALY_SPECIES_GAP_DAYS=180
# Janela (dias) para não repetir a mesma anomalia de espécie (evita spam).
ANOMALY_COOLDOWN_DAYS=30
# --- AI Core (IA visível/transparente) ---
# Habilita os "pensamentos" da IA no painel (log cognitivo) e a anotação
# ornitológica automática nos metadados da visita. Desligue para economizar CPU.
AI_INSIGHTS_ENABLED=true
# Capacidade do buffer circular do log cognitivo (últimos eventos em memória).
AI_COGNITIVE_LOG_CAPACITY=400
# --- Central de Câmeras / Multi-Câmera (Bem-Te-Vi Core distribuído) ---
# Chave mestra Fernet para criptografar as credenciais das câmeras em repouso
# (usuário/senha). Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Se vazio, usa/gera a chave local em app-data/secrets/camera_key.fernet.
ENCRYPTION_KEY=
# Teto de workers simultâneos (1 thread de captura + IA por câmera ativa).
CAMERA_MAX_WORKERS=8
# Backoff exponencial de reconexão dos streams externos (base e teto, segundos).
CAMERA_BACKOFF_BASE_SEC=1.0
CAMERA_BACKOFF_MAX_SEC=30.0
# Quadros/segundo entregues pelo proxy MJPEG seguro (/api/streams/proxy).
CAMERA_PROXY_FPS=15
# --- Lives do YouTube (tradutor de links → stream direto via yt-dlp) ---
# Quando ligado, links do YouTube (youtube.com/youtu.be) cadastrados como câmera
# são traduzidos para o stream HLS direto (m3u8) antes de o OpenCV abrir — o
# OpenCV/FFmpeg não abre a página web do YouTube.
YOUTUBE_RESOLVER_ENABLED=true
# Tempo (s) de cache do link direto extraído. Lives renovam o token de acesso com
# o tempo; ao cair, a reconexão força uma re-extração imediata (ignora o cache).
YOUTUBE_RESOLVER_CACHE_SEC=90
# Opcional: arquivo de cookies do YouTube (formato Netscape) para lives que
# exigem login/verificação anti-bot. Gere com:
#   yt-dlp --cookies-from-browser chrome --cookies cookies.txt <url_da_live>
# (o backend já tenta automaticamente um cliente alternativo contra o bot check).
YOUTUBE_COOKIES_FILE=
# --- Inteligência adaptativa (aprendizado ativo, memória, reidentificação) ---
# Fila de amostras + fine-tuning incremental do Bem-Te-Vi Core.
ACTIVE_LEARNING_ENABLED=true
# Mínimo de amostras por espécie para a classe entrar no treino.
ACTIVE_LEARNING_MIN_SAMPLES=8
FINE_TUNE_BASE_MODEL=yolov8n-cls.pt
FINE_TUNE_EPOCHS=8
FINE_TUNE_BATCH=8
FINE_TUNE_IMGSZ=224
FINE_TUNE_MIN_CONFIDENCE=0.35
# Memória comportamental (previsão de picos por horário/clima/estação).
BEHAVIORAL_MEMORY_ENABLED=true
BEHAVIORAL_REFRESH_MINUTES=60
BEHAVIORAL_HISTORY_DAYS=120
BEHAVIORAL_PREDICTION_HOURS=2
# Assinaturas visuais e reidentificação individual ("Conhecidos do Jardim").
VISUAL_EMBEDDINGS_ENABLED=true
# Similaridade de cosseno mínima para considerar o mesmo indivíduo.
INDIVIDUAL_MATCH_THRESHOLD=0.86
# Nitidez mínima (variância do Laplaciano) para extrair a assinatura.
INDIVIDUAL_MIN_SHARPNESS=25
INDIVIDUAL_MAX_CANDIDATES=250
# --- Segurança de acesso ---
# A API só aceita conexões do próprio computador (loopback) por padrão.
# Só defina como true se for expor conscientemente a API na rede — de
# preferência atrás de um proxy reverso com autenticação.
ALLOW_REMOTE_ACCESS=false
# Hosts aceitos no cabeçalho Host (separados por vírgula).
ALLOWED_HOSTS=127.0.0.1,localhost
# --- Rede Global Bem-Te-Vi Monitor (jardins conectados) ---
# O feed local de destaques funciona mesmo sem pares configurados.
GLOBAL_NETWORK_ENABLED=true
# Nome deste jardim exibido no feed das outras instâncias.
GLOBAL_NETWORK_INSTANCE_NAME=Meu Jardim
# Segredo compartilhado entre as instâncias. Sem ele, o webhook fica desligado.
# Envie o mesmo valor em todos os jardins e use uma string longa e aleatória.
GLOBAL_NETWORK_TOKEN=
# URLs base das instâncias parceiras, separadas por vírgula.
# Exemplo: https://jardim-paris.exemplo.org,https://jardim-serra.exemplo.org
GLOBAL_NETWORK_PEERS=
# Compartilhar também avistamentos comuns (padrão: apenas raros/incomuns).
GLOBAL_NETWORK_SHARE_ALL=false
# Janela e limite do card "Feed Global Bem-Te-Vi Monitor" do painel.
GLOBAL_NETWORK_FEED_DAYS=7
GLOBAL_NETWORK_FEED_LIMIT=20
# Timeout (s) da publicação em um par, em thread separada.
GLOBAL_NETWORK_TIMEOUT_SECONDS=5.0
# --- Resumo Matinal Automatizado (Morning Briefing) ---
# Compila clima, predições e foto de destaque e envia via Telegram/Discord.
MORNING_BRIEFING_ENABLED=true
# Horário de envio do resumo matinal (formato 24h).
MORNING_BRIEFING_HOUR=7
MORNING_BRIEFING_MINUTE=0
# --- Escuta Noturna de Migração (NFC: Nocturnal Flight Calls) ---
# Liga o modo de escuta noturna: durante a janela o limiar de confiança do
# BirdNET é reduzido para captar chamados curtos de aves em migração.
NFC_MONITOR_ENABLED=true
# Início/fim da janela noturna em horário local (padrão: 22:00 às 05:00).
NFC_NIGHT_START_HOUR=22
NFC_NIGHT_END_HOUR=5
# Limiar de confiança reduzido dentro da janela (menor = mais sensível).
NFC_CONFIDENCE_THRESHOLD=0.45
# Nota exibida no feed para registros noturnos.
NFC_NOTE=Chamado de voo (NFC)
# Optional: override path for local app data (default: back/app-data)
# APP_DATA_DIR=
