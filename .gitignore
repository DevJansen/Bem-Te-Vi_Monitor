# =====================================================================
# Bem-Te-Vi — arquivos que NUNCA devem ser versionados
# =====================================================================

# --- Segredos e variáveis de ambiente -------------------------------
# Bloqueia .env, .env.local, .env.production, .env.* em qualquer pasta.
# O .env.example (modelo sem valores reais) continua versionado.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
back/*env
front/*env

# --- Ambientes virtuais e dependências ------------------------------
*venv
*venv/
node_modules/
front/node_modules/

# --- Python: bytecode compilado -------------------------------------
__pycache__/
*.py[cod]

# --- Build do frontend (gerado por `npm run build`) -----------------
front/dist/
front/node_modules

# --- Bancos de dados locais (SQLite) --------------------------------
# O banco fica em back/app-data, mas bloqueamos o padrão em qualquer lugar.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# --- Logs -----------------------------------------------------------
*.log
logs/

# --- Mídia e gravações locais de teste ------------------------------
# Clipes, miniaturas, recortes, importações e gravações nunca vão para o Git.
media/
recordings/
back/app-data/*
!back/app-data/.gitkeep
